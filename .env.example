# Copy to .env.local and fill in. Also set these in Netlify -> Site settings ->
# Environment variables, or the contact form will fail in production.
#
# Microsoft Graph, app-only (client credentials) flow — mirrors the env contract
# in korvai-platform-v2-core.

# Optional. Defaults to https://graph.microsoft.com/.default when unset.
DEFAULT_EMAIL_SERVICE_URL=
# Optional. `<tenantId>` is substituted at runtime. Built from MS_TENANT_ID when unset.
DEFAULT_TOKEN_URL=

# Required — Azure AD app registration with the Mail.Send APPLICATION permission
# (admin consented).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Required — the mailbox the site sends AS. Must be a real mailbox in the tenant
# that the app is permitted to send from.
MS_FROM_EMAIL=

# Required — where contact-form enquiries are delivered. Any address, any domain.
# Comma-separated for multiple recipients.
MAIL_TO=
